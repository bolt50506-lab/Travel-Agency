# Hosted Supabase (recommended)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-side-service-role-key
# POSTGREST_URL is optional; it defaults to NEXT_PUBLIC_SUPABASE_URL/rest/v1
# POSTGREST_JWT_SECRET is only needed for the legacy self-hosted PostgREST mode.
POSTGREST_URL=
POSTGREST_JWT_SECRET=
LOCAL_AUTH_SECRET=replace-with-a-different-long-random-secret

# Flights
FLIGHT_PROVIDER=multi
FLIGHT_PROVIDERS=duffel,letsfg
ALLOW_MOCK_PROVIDERS=false
LETSFG_API_KEY=
LETSFG_MODE=sandbox
DUFFEL_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
TRAVELPORT_CLIENT_ID=
TRAVELPORT_CLIENT_SECRET=

# Hotels
HOTEL_PROVIDER=mock
DUFFEL_STAYS_API_KEY=
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
EXPEDIA_API_KEY=
EXPEDIA_SECRET=

# Payments
PAYMENT_PROVIDER=manual
PAYMENT_CURRENCY=PKR
BANK_ACCOUNT_TITLE=
BANK_ACCOUNT_NUMBER=
BANK_IBAN=
BANK_NAME=
RAAST_ID=
JAZZCASH_NUMBER=
EASYPAISA_NUMBER=

# Notifications
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
