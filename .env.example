# Self-hosted PostgreSQL / PostgREST
POSTGRES_DB=voyago
POSTGRES_USER=voyago
POSTGRES_PASSWORD=change-this-db-password
POSTGREST_DB_PASSWORD=change-this-postgrest-password
POSTGREST_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
POSTGREST_URL=http://127.0.0.1:3001
LOCAL_AUTH_SECRET=replace-with-a-different-long-random-secret

# Flights
FLIGHT_PROVIDER=mock
DUFFEL_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
TRAVELPORT_CLIENT_ID=
TRAVELPORT_CLIENT_SECRET=

# Hotels
HOTEL_PROVIDER=mock
DUFFEL_STAYS_API_KEY=
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
EXPEDIA_API_KEY=
EXPEDIA_SECRET=

# Payments
PAYMENT_PROVIDER=manual
PAYMENT_CURRENCY=PKR
BANK_ACCOUNT_TITLE=
BANK_ACCOUNT_NUMBER=
BANK_IBAN=
BANK_NAME=
RAAST_ID=
JAZZCASH_NUMBER=
EASYPAISA_NUMBER=

# Notifications
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
